{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"outDir": "./dist-mcp",
		"rootDir": "./src/mcp",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"sourceMap": true
	},
	"include": ["src/mcp/**/*"],
	"exclude": ["node_modules", "dist-mcp"]
}
